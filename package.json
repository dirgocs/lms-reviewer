{
  "name": "@dirgocs/lms-reviewer",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Gate de push bloqueante: cadeia de revisores headless (Claude/Grok/Codex) com scorecard verificado contra o disco",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "lms-trigger": "./scripts/lms-reviewer-trigger.sh",
    "lms-reviewer": "./scripts/lms-reviewer-spawn.sh",
    "lms-reviewer-tmux": "./scripts/lms-reviewer-tmux.mjs",
    "lms-push-gate": "./scripts/lms-push-gate.mjs",
    "lms-exempt-paths": "./scripts/lms-exempt-paths.mjs"
  },
  "scripts": {
    "test": "node --test scripts/*.test.mjs && sh scripts/lms-push-changed.test.sh && bash hooks/local-merge-score-gate.test.sh",
    "lms:reviewer": "bash scripts/lms-reviewer-spawn.sh",
    "lms:reviewer:tmux": "node scripts/lms-reviewer-tmux.mjs",
    "lms:trigger": "bash scripts/lms-reviewer-trigger.sh"
  },
  "files": [
    "scripts/",
    "hooks/",
    "skills/",
    "docs/",
    "lms.config.example.json",
    "README.md",
    "CHANGELOG.md"
  ]
}
