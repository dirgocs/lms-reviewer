+import { db } from '../db';
+
+// Emissão de documento fiscal por id.
+export async function emitir(id: string) {
+  const emissao = await db.emissao.findUnique({
+    where: { id },
+  });
+  if (!emissao) throw new Error('nao encontrado');
+  return emissao;
+}
